# Local development only. Copy to .env; never commit .env.
VERDICT_DATABASE_URL=postgres://verdict:verdict@localhost:5433/verdict?sslmode=disable
VERDICT_TEST_DATABASE_URL=postgres://verdict:verdict@localhost:5433/verdict_test?sslmode=disable
# Directory that scripts/eod2-sync.sh keeps the eod2 checkout in.
EOD2_DIR=~/.local/share/eod2
