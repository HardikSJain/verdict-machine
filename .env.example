# Local development only; never commit .env.
# Nothing in this repository loads .env: not the Go binary, not the Makefile
# (its own DB_URL/TEST_DB_URL defaults are defined inside it), and not
# docker-compose.yml (every value there is written out literally). Copying
# this file is therefore not enough -- source it into your shell yourself:
#   cp .env.example .env && set -a && . ./.env && set +a
VERDICT_DATABASE_URL=postgres://verdict:verdict@localhost:5433/verdict?sslmode=disable
VERDICT_TEST_DATABASE_URL=postgres://verdict:verdict@localhost:5433/verdict_test?sslmode=disable
# Directory that scripts/eod2-sync.sh keeps the eod2 checkout in.
EOD2_DIR=~/.local/share/eod2
